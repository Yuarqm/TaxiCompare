{
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Database=taxicompare_pricing;Username=postgres;Password=postgres",
    "Redis": "redis:6379"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_SECURE_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "TaxiCompare.Identity",
    "Audience": "TaxiCompare.Client",
    "ExpiryMinutes": 60
  },
  "AllowedOrigins": "http://localhost:5000,https://taxicompare.app",
  "Providers": {
    "Uber": {
      "ClientId": "YOUR_UBER_CLIENT_ID",
      "ServerToken": "YOUR_UBER_SERVER_TOKEN"
    },
    "Bolt": {
      "ApiKey": "YOUR_BOLT_API_KEY"
    },
    "Yandex": {
      "ApiKey": "YOUR_YANDEX_API_KEY",
      "ClueId": "YOUR_YANDEX_CLUE_ID"
    },
    "FreeNow": {
      "ClientId": "YOUR_FREENOW_CLIENT_ID",
      "ClientSecret": "YOUR_FREENOW_CLIENT_SECRET"
    },
    "Lyft": {
      "ClientId": "YOUR_LYFT_CLIENT_ID",
      "ClientSecret": "YOUR_LYFT_CLIENT_SECRET"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
