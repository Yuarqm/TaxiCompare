@page "/login"
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject IToastService Toast

<PageTitle>Вход – ТаксиСравни</PageTitle>

<div class="auth-page">
    <div class="auth-card card card-glass animate-fade-up">
        <div class="text-center mb-24">
            <div class="brand" style="justify-content:center; margin-bottom:24px;">
                <svg width="40" height="40" viewBox="0 0 48 48" fill="none">
                    <rect width="48" height="48" rx="14" fill="#00D46A"/>
                    <path d="M12 30L20 18L28 26L36 16" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="36" cy="16" r="3" fill="white"/>
                </svg>
            </div>
            <h1 class="auth-title">Добро пожаловать</h1>
            <p class="auth-subtitle">Войдите, чтобы просматривать историю поездок и настраивать оповещения</p>
        </div>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="badge badge-danger mb-16" style="width:100%; justify-content:center;">@Error</div>
        }

        <div class="form-group">
            <label>Электронная почта</label>
            <input class="form-input" type="email" placeholder="you@example.com" @bind="Email" />
        </div>
        <div class="form-group">
            <label>Пароль</label>
            <input class="form-input" type="password" placeholder="••••••••" @bind="Password" @onkeydown="HandleKeyDown" />
        </div>

        <button class="btn btn-primary" style="width:100%;" @onclick="DoLogin" disabled="@IsLoading">
            @if (IsLoading) { <span>Вход...</span> } else { <span>Войти</span> }
        </button>

        <div class="form-divider">или</div>

        <div class="text-center">
            <span class="text-secondary" style="font-size:14px;">Нет аккаунта? </span>
            <a href="/register" class="text-accent" style="font-size:14px; font-weight:600;">Зарегистрируйтесь бесплатно</a>
        </div>
    </div>
</div>

@code {
    private string Email = "";
    private string Password = "";
    private string? Error;
    private bool IsLoading;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoLogin();
    }

    private async Task DoLogin()
    {
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        {
            Error = "Пожалуйста, введите email и пароль.";
            return;
        }
        IsLoading = true;
        Error = null;
        var result = await AuthService.LoginAsync(Email, Password);
        IsLoading = false;
        if (result is null) { Error = "Неверный email или пароль."; }
        else { Toast.ShowSuccess($"С возвращением, {result.User.FirstName}!"); Nav.NavigateTo("/"); }
    }
}
