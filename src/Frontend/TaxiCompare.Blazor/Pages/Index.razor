        };
    }

    // ─── Заказ такси ──────────────────────────────────────────────────────────

    /// <summary>
    /// Открывает официальный сайт провайдера с предзаполненным маршрутом,
    /// одновременно фиксируя факт заказа в истории (если пользователь авторизован).
    /// </summary>
    private async Task OrderTaxi(ProviderPriceDto price)
    {
        OrderingSlug = price.ProviderSlug + price.VehicleClass;
        StateHasChanged();

        try
        {
            // 1. Фиксируем заказ в истории (только для авторизованных пользователей)
            var isAuth = await AuthService.IsAuthenticatedAsync();
            if (isAuth && Result?.RideRequestId != Guid.Empty)
            {
                try
                {
                    await Http.PostAsJsonAsync(
                        $"/api/rides/{Result!.RideRequestId}/order",
                        new { ProviderName = price.ProviderName, ProviderSlug = price.ProviderSlug,
                              VehicleClass = price.VehicleClass, Price = price.Price });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Order] Не удалось зафиксировать заказ: {ex.Message}");
                    // Не блокируем — всё равно открываем сайт провайдера
                }
            }

            // 2. Формируем глубокую ссылку на официальный сайт провайдера
            var url = GetProviderOrderUrl(price.ProviderSlug, OriginAddress, DestinationAddress,
                OriginLat, OriginLng, DestLat, DestLng);

            // 3. Открываем в новой вкладке
            await JS.InvokeVoidAsync("open", url, "_blank");

            Toast.ShowSuccess($"Переходим к {price.ProviderName}. Поездка зафиксирована в истории.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OrderTaxi] Error: {ex.Message}");
            Toast.ShowError("Не удалось открыть сайт провайдера");
        }
        finally
        {
            OrderingSlug = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Возвращает URL на официальный сайт такси-провайдера.
    /// Где API позволяет — передаёт координаты маршрута в query-параметрах.
    /// </summary>
    private static string GetProviderOrderUrl(
        string slug, string originAddr, string destAddr,
        double oLat, double oLng, double dLat, double dLng)
    {
        var originEnc = Uri.EscapeDataString(originAddr);
        var destEnc   = Uri.EscapeDataString(destAddr);

        return slug switch
        {
            // Яндекс Go — рабочий deep link с координатами маршрута
            "yandex" => $"https://3.redirect.appmetrica.yandex.com/route" +
                        $"?start-lat={oLat:F6}&start-lon={oLng:F6}" +
                        $"&end-lat={dLat:F6}&end-lon={dLng:F6}" +
                        $"&appmetrica_tracking_id=1178268795219968205",

            // Uber — deep link с координатами
            "uber"   => $"https://m.uber.com/ul/?" +
                        $"action=setPickup" +
                        $"&pickup[latitude]={oLat:F6}&pickup[longitude]={oLng:F6}" +
                        $"&pickup[nickname]={originEnc}" +
                        $"&dropoff[latitude]={dLat:F6}&dropoff[longitude]={dLng:F6}" +
                        $"&dropoff[nickname]={destEnc}",

            // Омега Такси — официальный сайт
            "omega"  => "https://taxiomega.ru/ru/",

            // Такси Максим — официальный сайт
            "maksim" => "https://taximaxim.com/",

            _        => "https://taxiomega.ru/ru/"
        };
    }

    public void Dispose() => _selfRef?.Dispose();

